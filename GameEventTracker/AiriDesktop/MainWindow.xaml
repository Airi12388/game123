<Window x:Class="AiriDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="Airi's" Height="940" Width="1480" MinHeight="760" MinWidth="1200"
        WindowStartupLocation="CenterScreen" Background="#0D0D10" Foreground="#F2F2F5"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="Panel" Color="#16161B" />
        <SolidColorBrush x:Key="Panel2" Color="#1D1D23" />
        <SolidColorBrush x:Key="Line" Color="#2A2A31" />
        <SolidColorBrush x:Key="Text" Color="#F2F2F5" />
        <SolidColorBrush x:Key="Muted" Color="#8E8E99" />
        <SolidColorBrush x:Key="Soft" Color="#C9C9D1" />
        <SolidColorBrush x:Key="Orange" Color="#F0812F" />
        <SolidColorBrush x:Key="Red" Color="#EE4B2B" />
        <SolidColorBrush x:Key="Yellow" Color="#F5C518" />
        <SolidColorBrush x:Key="Purple" Color="#A15CF6" />
        <SolidColorBrush x:Key="Blue" Color="#4C8DFF" />
        <SolidColorBrush x:Key="Green" Color="#22B573" />
        <SolidColorBrush x:Key="Cyan" Color="#4CC9FF" />
        <FontFamily x:Key="Display">Segoe UI Black</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <!-- ===== Text ===== -->
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Orange}" />
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="30" />
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MonoSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- ===== Containers ===== -->
        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="Background" Value="#26262D" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="10,4,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#121216" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="Background" Value="#121216" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="6,6,18,6" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="IconDot" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Buttons ===== -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Panel2}" />
            <Setter Property="BorderBrush" Value="#34343D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin=".5,.5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value=".88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value=".38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Orange}" />
            <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
            <Setter Property="Foreground" Value="#1B0F04" />
            <Setter Property="FontFamily" Value="{StaticResource Display}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="26,12" />
        </Style>
        <Style x:Key="YellowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Yellow}" />
            <Setter Property="BorderBrush" Value="{StaticResource Yellow}" />
            <Setter Property="Foreground" Value="#17140A" />
            <Setter Property="Padding" Value="20,14" />
        </Style>
        <Style x:Key="SmallPill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Green}" />
            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
            <Setter Property="Foreground" Value="#06150D" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A32" />
                                <Setter Property="Foreground" Value="{StaticResource Red}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#06150D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="24" Height="24" CornerRadius="12" BorderThickness="2" BorderBrush="#4A4A55" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="Bold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Green}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Green}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Green}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top navigation tabs: white text with a red underline when active -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A9A9B3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Red}" Visibility="Hidden" Margin="-4,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented filter pills: yellow when active -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24242B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yellow}" />
                                <Setter Property="Foreground" Value="#17140A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentBox" TargetType="Border">
            <Setter Property="Background" Value="#111115" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- ===== Inputs ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#111115" />
            <Setter Property="BorderBrush" Value="#2E2E36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#6E6E79" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Orange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#111115" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="12">
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#1D1D23" BorderBrush="#34343D" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="#111115" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="12">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" />
                                <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource IconButton}" Focusable="False" Margin="0,0,6,0"
                                        Content="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource Orange}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#2A2A31" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scrollbars -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb"><Border Background="#3A3A44" CornerRadius="4" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Lists ===== -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,4,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Panel2}" BorderBrush="#26262D" BorderThickness="1" CornerRadius="14" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A44" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Orange}" />
                                <Setter TargetName="Bd" Property="Background" Value="#22180F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card grid: no inner scroller, so the page scrolls as one -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,16,18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="20" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-4" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Orange}" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#F0812F" BlurRadius="24" ShadowDepth="0" Opacity=".5" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardGrid" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Character cards ===== -->
        <!-- The card itself: rarity-colored frame, name + rarity badge, art, number, series, POW/AURA strip -->
        <DataTemplate x:Key="CardFace">
            <Border Width="180" BorderBrush="{Binding Accent}" BorderThickness="3" CornerRadius="13" Background="{Binding Surface}" Padding="8,7,8,8">
                <StackPanel>
                    <DockPanel Margin="2,0,0,7">
                        <Border DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="11" Background="{Binding Accent}">
                            <TextBlock Text="{Binding RarityLetter}" FontFamily="{StaticResource Display}" FontSize="11" Foreground="#141414"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="14" Foreground="White"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </DockPanel>
                    <Border Height="196" CornerRadius="8" Background="{Binding ArtBackground}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontSize="58" Foreground="#38FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}" />
                            <Image gif:ImageBehavior.AnimatedSource="{Binding Portrait}" gif:ImageBehavior.RepeatBehavior="Forever" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border VerticalAlignment="Bottom" Height="54">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#B8000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Number}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="#E6FFFFFF"
                                       VerticalAlignment="Bottom" Margin="8,0,0,7" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4EA" Margin="2,8,0,7" TextTrimming="CharacterEllipsis" />
                    <Border Background="#8C000000" CornerRadius="6" Padding="9,5">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Foreground="White">
                                <Run Text="AURA " /><Run Text="{Binding Aura, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Foreground="White">
                                <Run Text="POW " /><Run Text="{Binding Pow, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Collection tile: the card on a dark plate, with ownership underneath -->
        <DataTemplate x:Key="CharacterCard">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="10,10,10,8">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardFace}" Opacity="{Binding CardOpacity}" />
                    <DockPanel Margin="2,10,2,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RarityLabel}" Foreground="{Binding Accent}" FontFamily="{StaticResource Mono}"
                                   FontSize="11" VerticalAlignment="Center" />
                        <Border BorderBrush="#3A3A44" BorderThickness="1" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding OwnedLabel}" Foreground="{Binding OwnedBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Small party card for the Rift view -->
        <DataTemplate x:Key="MiniCard">
            <Border Width="112" Margin="0,0,10,10" BorderBrush="{Binding Accent}" BorderThickness="2" CornerRadius="10" Background="{Binding Surface}" Padding="5">
                <StackPanel>
                    <Border Height="112" CornerRadius="6" Background="{Binding ArtBackground}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontSize="32" Foreground="#38FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}" />
                            <Image gif:ImageBehavior.AnimatedSource="{Binding Portrait}" gif:ImageBehavior.RepeatBehavior="Forever" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="2,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RarityLetter}" Foreground="{Binding Accent}" FontFamily="{StaticResource Display}" FontSize="10" />
                        <TextBlock Text="{Binding CopiesText}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Muted}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Tiny card for the "last signal" strip -->
        <DataTemplate x:Key="TinyCard">
            <Border Width="56" Height="74" Margin="0,0,7,7" BorderBrush="{Binding Accent}" BorderThickness="2" CornerRadius="8"
                    Background="{Binding ArtBackground}" ClipToBounds="True" ToolTip="{Binding Name}">
                <Grid>
                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontSize="16" Foreground="#55FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InitialsVisibility}" />
                    <Image gif:ImageBehavior.AnimatedSource="{Binding Portrait}" gif:ImageBehavior.RepeatBehavior="Forever" Stretch="UniformToFill" />
                    <Border Width="15" Height="15" CornerRadius="8" Background="{Binding Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0">
                        <TextBlock Text="{Binding RarityLetter}" FontFamily="{StaticResource Display}" FontSize="8" Foreground="#141414"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Border Grid.Row="0" BorderBrush="#1F1F26" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20" BorderBrush="#5A3426" BorderThickness="2" Background="#1A1210" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource Red}">
                            <TextBlock Text="ア" Foreground="#1A0C08" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <TextBlock Text="AIRI'S" FontFamily="{StaticResource Display}" FontSize="19" VerticalAlignment="Center" Margin="0,0,34,0" />
                    <RadioButton x:Name="NavTracker" Style="{StaticResource NavTab}" Content="Tracker" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavBoosters" Style="{StaticResource NavTab}" Content="Signal Booth" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavRift" Style="{StaticResource NavTab}" Content="Rift Descent" Checked="Nav_Checked" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#121216" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="22" Height="44" Padding="18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="TopWaveText" Text="W1" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="14" />
                            <ProgressBar x:Name="TopWaveBar" Height="3" Width="36" Maximum="1" Foreground="{StaticResource Red}" Margin="0,3,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Text="⚡" Foreground="{StaticResource Orange}" VerticalAlignment="Center" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="16,11" />
                        <TextBlock Text="◆" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="BalanceText" Text="0" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== Status chips ===== -->
        <WrapPanel Grid.Row="1" Margin="24,18,24,6">
            <Border Style="{StaticResource StatusChip}" BorderBrush="#4A2620">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconDot}" Background="#3A1C16"><TextBlock Text="日" Foreground="{StaticResource Red}" Style="{StaticResource IconGlyph}" /></Border>
                    <TextBlock x:Name="ChipDailyText" Text="0/0" Foreground="{StaticResource Red}" Style="{StaticResource ChipNumber}" />
                    <TextBlock Text="daily quests today" Style="{StaticResource ChipLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusChip}" BorderBrush="#1E4030">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconDot}" Background="#14301F"><TextBlock Text="週" Foreground="{StaticResource Green}" Style="{StaticResource IconGlyph}" /></Border>
                    <TextBlock x:Name="ChipWeeklyText" Text="0" Foreground="{StaticResource Green}" Style="{StaticResource ChipNumber}" />
                    <TextBlock Text="weekly rewards ready" Style="{StaticResource ChipLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusChip}" BorderBrush="#33244F">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconDot}" Background="#261A3C"><TextBlock Text="催" Foreground="{StaticResource Purple}" Style="{StaticResource IconGlyph}" /></Border>
                    <TextBlock x:Name="ChipEventsText" Text="00" Foreground="{StaticResource Purple}" Style="{StaticResource ChipNumber}" />
                    <TextBlock Text="upcoming events" Style="{StaticResource ChipLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusChip}" BorderBrush="#3E3416">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconDot}" Background="#2E2710"><TextBlock Text="金" Foreground="{StaticResource Yellow}" Style="{StaticResource IconGlyph}" /></Border>
                    <TextBlock x:Name="ChipPityText" Text="50" Foreground="{StaticResource Yellow}" Style="{StaticResource ChipNumber}" />
                    <TextBlock Text="cards until a sure Legendary" Style="{StaticResource ChipLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusChip}" BorderBrush="#4A2E1A">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconDot}" Background="#3A2414"><TextBlock Text="戦" Foreground="{StaticResource Orange}" Style="{StaticResource IconGlyph}" /></Border>
                    <TextBlock x:Name="ChipWaveText" Text="W1" Foreground="{StaticResource Orange}" Style="{StaticResource ChipNumber}" />
                    <TextBlock Text="rift descent" Style="{StaticResource ChipLabel}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="24,8,24,24">

            <!-- ================= TRACKER ================= -->
            <Grid x:Name="TrackerView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBox}" Margin="0,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="YOUR LIBRARY" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Games" Style="{StaticResource H2}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBox x:Name="GameNameInput" Tag="What are you playing?" KeyDown="GameNameInput_KeyDown" />
                            <Button Content="+  Add a game" Click="AddGame_Click" />
                        </StackPanel>
                        <ListBox x:Name="GamesList" SelectedValuePath="Id" SelectionChanged="GamesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="×" Tag="{Binding Id}" Click="RemoveGame_Click"
                                                Visibility="{Binding RemoveVisibility}" ToolTip="Remove this game, its events and quests" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,11,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBox}" Margin="0,0,16,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource FilterChip}" Content="All" Tag="all" GroupName="EventFilter" IsChecked="True" Checked="EventFilter_Checked" />
                                    <RadioButton Style="{StaticResource FilterChip}" Content="Upcoming" Tag="upcoming" GroupName="EventFilter" Checked="EventFilter_Checked" />
                                    <RadioButton Style="{StaticResource FilterChip}" Content="Done" Tag="done" GroupName="EventFilter" Checked="EventFilter_Checked" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="YOUR CALENDAR" Style="{StaticResource Kicker}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Event radar" Style="{StaticResource H2}" />
                                    <Border Style="{StaticResource CountBadge}"><TextBlock x:Name="EventCountText" Text="0" Style="{StaticResource MonoSmall}" /></Border>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,14">
                            <Run Text="Event clears earn " /><Run Text="+100 ◆" Foreground="{StaticResource Cyan}" FontWeight="Bold" />
                        </TextBlock>
                        <Border DockPanel.Dock="Bottom" Background="#111115" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,14,14,6" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="EventTitleInput" Grid.Row="0" Grid.Column="0" Tag="New event, e.g. Double XP weekend" Margin="0,0,8,8" KeyDown="EventTitleInput_KeyDown" />
                                <ComboBox x:Name="EventGameInput" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="EventStartInput" Grid.Column="0" ToolTip="Starts" />
                                    <DatePicker x:Name="EventEndInput" Grid.Column="1" ToolTip="Ends" />
                                </Grid>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add event" Padding="16,10" Margin="0,0,0,8" Click="AddEvent_Click" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ListBox x:Name="EventsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SmallPill}" Content="Done  +100" Tag="{Binding Id}" Click="CompleteEvent_Click"
                                                        Visibility="{Binding CompleteVisibility}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource IconButton}" Content="×" Tag="{Binding Id}" Click="RemoveEvent_Click" ToolTip="Remove event" />
                                            </StackPanel>
                                            <Border Width="4" CornerRadius="2" Background="{Binding GameBrush}" Margin="0,0,14,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding GameName}" Foreground="{Binding GameBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Dates}" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Soft}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                    <Border BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Style="{StaticResource MonoSmall}" FontSize="10" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Countdown}" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EventsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="No events in this view" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Text="Add one below to keep its dates close at hand." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Text="RESETS DAILY" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            <StackPanel>
                                <TextBlock Text="A LITTLE PROGRESS ADDS UP" Style="{StaticResource Kicker}" />
                                <TextBlock Style="{StaticResource H2}"><Run Text="Daily quests " /><Run Text="✳" Foreground="{StaticResource Orange}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <ComboBox x:Name="QuestGameInput" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="QuestGameInput_SelectionChanged" Margin="0,0,0,12" />
                        <Grid Grid.Row="2">
                            <ListBox x:Name="DailyQuestsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource CheckButton}" Tag="{Binding Id}" Click="CompleteDaily_Click"
                                                    IsEnabled="{Binding CanComplete}" Content="{Binding CheckGlyph}" Margin="0,0,12,0" ToolTip="Mark done" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="×" Tag="{Binding Id}" Click="RemoveDailyQuest_Click" ToolTip="Remove quest" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RewardText}" Style="{StaticResource MonoSmall}" FontWeight="Bold"
                                                       Foreground="{Binding RewardBrush}" VerticalAlignment="Center" Margin="8,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="{Binding TitleOpacity}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="QuestsEmpty" Text="No daily quests for this game yet." Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DailyQuestNameInput" Grid.Column="0" Tag="New daily quest" Margin="0,0,8,0" KeyDown="DailyQuestNameInput_KeyDown" />
                            <TextBox x:Name="QuestRewardInput" Grid.Column="1" Tag="25 ◆" Margin="0,0,8,0" ToolTip="Pulse reward (1–1000)" />
                            <Button Grid.Column="2" Content="Add" Click="AddDailyQuest_Click" Height="40" Padding="16,0" />
                        </Grid>
                        <DockPanel Grid.Row="4" Margin="0,22,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="RESETS MON" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            <StackPanel>
                                <TextBlock Text="WEEKLY GOALS" Style="{StaticResource Kicker}" Foreground="{StaticResource Green}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Long game" Style="{StaticResource H2}" FontSize="18" />
                                    <Border Style="{StaticResource CountBadge}"><TextBlock x:Name="WeeklyDoneText" Text="0/3" Style="{StaticResource MonoSmall}" /></Border>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="WeeklyGoalsList" Grid.Row="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel2}" CornerRadius="14" Padding="14,11" Margin="0,0,0,8" BorderBrush="#26262D" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallPill}" Content="{Binding ButtonText}" IsEnabled="{Binding Ready}"
                                                    Tag="{Binding Id}" Click="ClaimWeekly_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <DockPanel Margin="0,7,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Soft}" Margin="10,0,0,0">
                                                        <Run Text="{Binding ProgressText, Mode=OneWay}" /><Run Text="  +" /><Run Text="{Binding Reward, Mode=OneWay}" /><Run Text=" ◆" Foreground="#4CC9FF" />
                                                    </TextBlock>
                                                    <ProgressBar Maximum="{Binding Target, Mode=OneWay}" Value="{Binding Shown, Mode=OneWay}" Foreground="{StaticResource Yellow}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= SIGNAL BOOTH ================= -->
            <Grid x:Name="BoostersView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,20,0" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- Hero banner -->
                        <Border CornerRadius="22" BorderBrush="#43271A" BorderThickness="1" Height="320" Margin="0,0,0,30" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D1411" Offset="0" />
                                    <GradientStop Color="#141317" Offset=".55" />
                                    <GradientStop Color="#24150F" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="48,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="400" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="信" FontSize="300" FontWeight="Bold" Foreground="#0AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-30,-60" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Red}" FontSize="12">
                                        <Run Text="PULSE EXCHANGE" /><Run Text="  ·  " Foreground="#8E8E99" /><Run Text="EVERY CHARACTER" Foreground="#C9C9D1" />
                                    </TextBlock>
                                    <TextBlock Text="Signal Booth" FontFamily="{StaticResource Display}" FontSize="56" Margin="0,6,0,6" />
                                    <TextBlock Text="Turn the Pulse from quests and events into character cards." Foreground="{StaticResource Soft}" FontSize="15" Margin="0,0,0,26" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="HeroPullButton" Style="{StaticResource PrimaryButton}" Click="PullOne_Click" Padding="26,10,12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Pull a card" VerticalAlignment="Center" />
                                                <Border Background="#1B0F04" CornerRadius="15" MinWidth="30" Height="30" Margin="16,0,0,0" Padding="6,0">
                                                    <TextBlock x:Name="HeroAffordText" Text="0" Foreground="{StaticResource Orange}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Pulls you can afford" />
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="HeroPullTenButton" Content="Pull 10  ·  900 ◆" Margin="12,0,0,0" Padding="24,14" Background="#141418" Click="PullTen_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- Fanned showcase of your best cards -->
                                <Grid Grid.Column="1" Width="380" Height="300">
                                    <ContentControl x:Name="HeroLeft" Focusable="False" ContentTemplate="{StaticResource CardFace}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,34,0,0" RenderTransformOrigin=".5,.5">
                                        <ContentControl.LayoutTransform><ScaleTransform ScaleX=".74" ScaleY=".74" /></ContentControl.LayoutTransform>
                                        <ContentControl.RenderTransform><RotateTransform Angle="-11" /></ContentControl.RenderTransform>
                                        <ContentControl.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity=".7" Color="Black" /></ContentControl.Effect>
                                    </ContentControl>
                                    <ContentControl x:Name="HeroCenter" Focusable="False" ContentTemplate="{StaticResource CardFace}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18" RenderTransformOrigin=".5,.5">
                                        <ContentControl.LayoutTransform><ScaleTransform ScaleX=".74" ScaleY=".74" /></ContentControl.LayoutTransform>
                                        <ContentControl.RenderTransform><RotateTransform Angle="-2" /></ContentControl.RenderTransform>
                                        <ContentControl.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity=".7" Color="Black" /></ContentControl.Effect>
                                    </ContentControl>
                                    <ContentControl x:Name="HeroRight" Focusable="False" ContentTemplate="{StaticResource CardFace}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,24,0,0" RenderTransformOrigin=".5,.5">
                                        <ContentControl.LayoutTransform><ScaleTransform ScaleX=".74" ScaleY=".74" /></ContentControl.LayoutTransform>
                                        <ContentControl.RenderTransform><RotateTransform Angle="9" /></ContentControl.RenderTransform>
                                        <ContentControl.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity=".7" Color="Black" /></ContentControl.Effect>
                                    </ContentControl>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Collection header + filters -->
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Text="Drag a picture onto a card, or double-click it · PNG, JPG or GIF" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Your collection" Style="{StaticResource H1}" />
                                <Border Style="{StaticResource CountBadge}"><TextBlock x:Name="CollectionCountText" Text="0/45" Style="{StaticResource MonoSmall}" /></Border>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Style="{StaticResource SegmentBox}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource FilterChip}" Content="All" Tag="0" GroupName="Rarity" IsChecked="True" Checked="RarityFilter_Checked" />
                                    <RadioButton Style="{StaticResource FilterChip}" Tag="3" GroupName="Rarity" Checked="RarityFilter_Checked" Padding="8,5,14,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Blue}" Margin="0,0,7,0"><TextBlock Text="R" FontFamily="{StaticResource Display}" FontSize="10" Foreground="#141414" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <TextBlock Text="Rare" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource FilterChip}" Tag="4" GroupName="Rarity" Checked="RarityFilter_Checked" Padding="8,5,14,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Purple}" Margin="0,0,7,0"><TextBlock Text="E" FontFamily="{StaticResource Display}" FontSize="10" Foreground="#141414" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <TextBlock Text="Epic" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource FilterChip}" Tag="5" GroupName="Rarity" Checked="RarityFilter_Checked" Padding="8,5,14,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Yellow}" Margin="0,0,7,0"><TextBlock Text="L" FontFamily="{StaticResource Display}" FontSize="10" Foreground="#141414" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <TextBlock Text="Legendary" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SegmentBox}" Margin="10,0,0,0">
                                <ToggleButton x:Name="OwnedOnlyToggle" Style="{StaticResource FilterChip}" Content="Owned only" Checked="OwnedOnly_Changed" Unchecked="OwnedOnly_Changed" />
                            </Border>
                            <ComboBox x:Name="SeriesFilterInput" Width="220" Margin="10,0,0,0" VerticalAlignment="Center" SelectionChanged="SeriesFilter_Changed" ToolTip="Filter by series" />
                        </StackPanel>

                        <ListBox x:Name="CharactersList" Style="{StaticResource CardGrid}" ItemTemplate="{StaticResource CharacterCard}" AllowDrop="True"
                                 SelectionChanged="CharactersList_SelectionChanged" MouseDoubleClick="CharactersList_MouseDoubleClick"
                                 DragOver="CharactersList_DragOver" Drop="CharactersList_Drop" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Booster panel -->
                <Border Grid.Column="1" Style="{StaticResource PanelBox}" Padding="0" VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="54" Height="54" CornerRadius="27" BorderBrush="{StaticResource Yellow}" BorderThickness="2" Background="#1C170A">
                                    <TextBlock Text="信" Foreground="{StaticResource Yellow}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Signal Mix" FontFamily="{StaticResource Display}" FontSize="23" />
                                    <TextBlock x:Name="PoolSubtitleText" Text="Every character" Foreground="{StaticResource Soft}" />
                                </StackPanel>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="-4,0,-4,16">
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="100" Style="{StaticResource TileNumber}" /><TextBlock Text="Pulse per card" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileEpicText" Text="10" Style="{StaticResource TileNumber}" Foreground="{StaticResource Purple}" /><TextBlock Text="until a sure Epic" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileLegendText" Text="50" Style="{StaticResource TileNumber}" Foreground="{StaticResource Red}" /><TextBlock Text="until a sure Legendary" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileOwnedText" Text="0/45" Style="{StaticResource TileNumber}" Foreground="{StaticResource Yellow}" /><TextBlock Text="characters collected" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                            </UniformGrid>

                            <TextBlock Text="CHANCE PER CARD" Style="{StaticResource Kicker}" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Blue}" FontWeight="SemiBold"><Run Text="● " /><Run Text="Rare" /></TextBlock>
                                <ProgressBar Grid.Column="1" Maximum="100" Value="70" Foreground="{StaticResource Blue}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="70%" Style="{StaticResource MonoSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Purple}" FontWeight="SemiBold"><Run Text="● " /><Run Text="Epic" /></TextBlock>
                                <ProgressBar Grid.Column="1" Maximum="100" Value="24" Foreground="{StaticResource Purple}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="24%" Style="{StaticResource MonoSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{StaticResource Yellow}" FontWeight="SemiBold"><Run Text="● " /><Run Text="Legendary" /></TextBlock>
                                <ProgressBar Grid.Column="1" Maximum="100" Value="6" Foreground="{StaticResource Yellow}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="6%" Style="{StaticResource MonoSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Button x:Name="PullOneButton" Style="{StaticResource YellowButton}" Margin="0,20,0,0" Click="PullOne_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pull" FontFamily="{StaticResource Display}" FontSize="17" VerticalAlignment="Center" />
                                    <Border Width="1" Background="#7A6418" Margin="16,2" />
                                    <TextBlock Text="100 ◆ · 1 card" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PullTenButton" Margin="0,10,0,0" Padding="20,13" Click="PullTen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pull 10" FontFamily="{StaticResource Display}" FontSize="15" VerticalAlignment="Center" />
                                    <Border Width="1" Background="#3A3A44" Margin="16,2" />
                                    <TextBlock Text="900 ◆ · 10% off" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="GachaResultText" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap" />

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,20" />
                            <TextBlock Text="LAST SIGNAL" Style="{StaticResource Kicker}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                            <ItemsControl x:Name="LastPullsList" ItemTemplate="{StaticResource TinyCard}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="LastPullsEmpty" Text="Nothing pulled yet." Style="{StaticResource MutedText}" />

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,20" />
                            <TextBlock Text="CARD ART" Style="{StaticResource Kicker}" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                            <TextBlock x:Name="SelectedCardText" Text="Select a card" FontWeight="Bold" FontSize="15" />
                            <TextBlock x:Name="SelectedCardFileText" Style="{StaticResource MonoSmall}" Foreground="{StaticResource Orange}" Margin="0,3,0,0" />
                            <TextBlock Text="Save a PNG, JPG or GIF from your browser, then drag it onto the card. Or drop files named after the character into the art folder; they appear when you reopen this tab. Pictures stay on this PC."
                                       Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,12" />
                            <Button x:Name="SetArtButton" Content="Choose image or GIF…" Click="ImportPortrait_Click" IsEnabled="False" />
                            <Button x:Name="RemoveArtButton" Content="Remove art" Click="RemoveArt_Click" IsEnabled="False" Margin="0,8,0,0" Background="Transparent" />
                            <Button Content="Open art folder" Click="OpenArtFolder_Click" Margin="0,8,0,0" Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================= RIFT DESCENT ================= -->
            <ScrollViewer x:Name="RiftView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel>
                    <Border x:Name="ArenaCard" CornerRadius="22" BorderBrush="#2E3A30" BorderThickness="1" Height="290" ClipToBounds="True" Background="#20372F">
                        <Grid>
                            <Canvas x:Name="ArenaCanvas" ClipToBounds="True" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D90D0D10" Offset="0" />
                                        <GradientStop Color="#000D0D10" Offset=".6" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="46,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock x:Name="BiomeText" Text="MOSSLIGHT RUINS" Style="{StaticResource Kicker}" Foreground="{StaticResource Yellow}" FontSize="12" />
                                <TextBlock x:Name="MonsterNameText" Text="Rift scout" FontFamily="{StaticResource Display}" FontSize="46" Margin="0,6,0,6" />
                                <TextBlock x:Name="EnemyStatsText" Foreground="#D9D9E0" FontFamily="{StaticResource Mono}" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button x:Name="PauseBattleButton" Style="{StaticResource PrimaryButton}" Content="Pause" Click="PauseBattle_Click" />
                                    <Button x:Name="ReturnBossButton" Content="Return to boss" Margin="12,0,0,0" Padding="22,12" Background="#141418" Click="ReturnBoss_Click" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="MonsterGlyphText" Text="◆" FontSize="96" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,96,40" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelBox}" Margin="0,16,0,16" Padding="22,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="340">
                                <TextBlock x:Name="WaveText" Text="WAVE 1" Style="{StaticResource Kicker}" Foreground="{StaticResource Red}" FontSize="12" />
                                <TextBlock x:Name="BattleStatusText" Text="Next wave in 12s" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid VerticalAlignment="Center">
                                <ProgressBar x:Name="WaveProgressBar" Height="8" Maximum="1" Foreground="{StaticResource Orange}" />
                                <ProgressBar x:Name="BossHealthBar" Height="8" Foreground="{StaticResource Red}" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelBox}" Margin="0,0,16,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="YOUR PARTY" Style="{StaticResource Kicker}" />
                                <TextBlock Text="Every pulled card fights" Style="{StaticResource H2}" Margin="0,2,0,14" />
                                <UniformGrid Columns="4" Margin="-4,0,-4,16">
                                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="StatHpText" Text="0" Style="{StaticResource TileNumber}" Foreground="{StaticResource Green}" FontSize="17" /><TextBlock Text="HP" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="StatAtkText" Text="0" Style="{StaticResource TileNumber}" Foreground="{StaticResource Red}" FontSize="17" /><TextBlock Text="POW" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="StatCritText" Text="0%" Style="{StaticResource TileNumber}" Foreground="{StaticResource Yellow}" FontSize="17" /><TextBlock Text="CRIT" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                    <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="StatArmorText" Text="0" Style="{StaticResource TileNumber}" Foreground="{StaticResource Blue}" FontSize="17" /><TextBlock Text="ARMOR" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                </UniformGrid>
                                <ItemsControl x:Name="PartyList" ItemTemplate="{StaticResource MiniCard}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelBox}" Margin="0,0,16,0" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource MonoSmall}" Margin="0,0,0,4">
                                        <Run Text="◆ " Foreground="#4CC9FF" /><Run x:Name="AlloyRun" Text="0" FontWeight="Bold" /><Run Text=" alloy" Foreground="#8E8E99" />
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="EXPEDITION LOOT" Style="{StaticResource Kicker}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Armory" Style="{StaticResource H2}" />
                                            <Border Style="{StaticResource CountBadge}"><TextBlock x:Name="ArmorCountText" Text="0" Style="{StaticResource MonoSmall}" /></Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Better gear is equipped automatically." Style="{StaticResource MutedText}" Margin="0,4,0,14" />
                                <ItemsControl x:Name="ArmorList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" BorderBrush="#26262D" BorderThickness="1">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontFamily="{StaticResource Mono}" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Green}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,0,10,0"
                                                            VerticalAlignment="Center" Visibility="{Binding EquippedVisibility}">
                                                        <TextBlock Text="EQUIPPED" Foreground="{StaticResource Green}" FontFamily="{StaticResource Mono}" FontSize="9" />
                                                    </Border>
                                                    <Border Width="36" Height="36" CornerRadius="10" BorderBrush="{Binding Accent}" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="◇" Foreground="{Binding Accent}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{Binding Accent}" FontFamily="{StaticResource Mono}" FontSize="11" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Bonuses}" Foreground="{StaticResource Soft}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding BonusVisibility}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ArmorEmpty" Text="No gear yet. Waves have a chance to drop armor." Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelBox}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="EXPEDITION LOG" Style="{StaticResource Kicker}" Margin="0,0,0,12" />
                                <ItemsControl x:Name="BattleLogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Soft}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= PULL REVEAL OVERLAY ================= -->
        <Grid x:Name="PullOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100" Background="#F2060608" MouseLeftButtonDown="PullOverlay_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Ellipse x:Name="PullGlow" Grid.RowSpan="3" Width="1000" Height="1000" Opacity="0" IsHitTestVisible="False" />

            <StackPanel x:Name="PullHeader" Grid.Row="0" HorizontalAlignment="Center" Margin="0,34,0,0" Opacity="0">
                <TextBlock Text="SIGNAL ACQUIRED" Style="{StaticResource Kicker}" FontSize="13" HorizontalAlignment="Center" />
                <TextBlock x:Name="PullSummaryText" FontFamily="{StaticResource Display}" FontSize="32" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- The pack -->
            <Grid x:Name="PackRoot" Grid.Row="1" Width="230" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border CornerRadius="14" BorderThickness="2" BorderBrush="#FFE27A">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFE15A" Offset="0" />
                            <GradientStop Color="#F5C518" Offset=".45" />
                            <GradientStop Color="#C98A12" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock Text="信" FontSize="230" FontWeight="Bold" Foreground="#14000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AIRI'S" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="13" Foreground="#3A2A05" HorizontalAlignment="Center" Margin="0,10,0,16" />
                            <Border Width="112" Height="112" CornerRadius="56" Background="#1A1405" BorderBrush="#FFF1B8" BorderThickness="4">
                                <TextBlock Text="信" FontSize="56" FontWeight="Bold" Foreground="{StaticResource Yellow}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Signal Mix" FontFamily="{StaticResource Display}" FontSize="25" Foreground="#2A1F04" HorizontalAlignment="Center" Margin="0,16,0,2" />
                            <TextBlock Text="Every character" FontSize="11" Foreground="#5A4510" HorizontalAlignment="Center" />
                            <Border Background="#1A1405" CornerRadius="10" Padding="11,3" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <TextBlock x:Name="PackCountText" Text="10 cards" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Yellow}" />
                            </Border>
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" Height="22" CornerRadius="0,0,12,12" Background="#30000000" />
                    </Grid>
                </Border>
                <Border x:Name="PackTear" VerticalAlignment="Top" Height="26" CornerRadius="12,12,0,0" Background="#D9A514" BorderBrush="#FFE27A" BorderThickness="2,2,2,0">
                    <TextBlock Text="◆  ◆  ◆  ◆  ◆  ◆  ◆" Foreground="#99FFF1B8" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <WrapPanel x:Name="PullCardsPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,34">
                <Button x:Name="PullContinueButton" Style="{StaticResource PrimaryButton}" Content="Continue" Click="PullContinue_Click" Padding="52,12" Opacity="0" IsHitTestVisible="False" />
                <TextBlock x:Name="PullHintText" Text="Click anywhere to skip" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <Border x:Name="PullFlash" Grid.RowSpan="3" Background="White" Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
