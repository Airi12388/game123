<Window x:Class="AiriDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Airi's" Height="920" Width="1440" MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#111712" Foreground="#EDF3E8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B231D" />
        <SolidColorBrush x:Key="InsetBrush" Color="#151C16" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#38443A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A2AE9E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D9FF72" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#283328" />
            <Setter Property="Foreground" Value="#EAF1E5" />
            <Setter Property="BorderBrush" Value="#526248" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#111712" />
            <Setter Property="Foreground" Value="#EDF3E8" />
            <Setter Property="BorderBrush" Value="#475449" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#202820" />
            <Setter Property="Foreground" Value="#EDF3E8" />
            <Setter Property="BorderBrush" Value="#475449" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#151C16" />
            <Setter Property="Foreground" Value="#EDF3E8" />
            <Setter Property="BorderBrush" Value="#38443A" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="#202820" />
            <Setter Property="Foreground" Value="#EDF3E8" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#202820" />
            <Setter Property="Foreground" Value="#EDF3E8" />
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A2AE9E" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF3E8" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="#D9FF72" Margin="0,0,10,0">
                    <TextBlock Text="A" Foreground="#182018" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AIRI'S" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#1D261F" BorderBrush="#38443A" BorderThickness="1" CornerRadius="5" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="PULSE  " Foreground="#A2AE9E" FontFamily="Consolas"/><TextBlock x:Name="BalanceText" Text="0" FontSize="16" FontWeight="Bold"/></StackPanel>
            </Border>
        </DockPanel>
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,14">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="UPCOMING EVENTS" Style="{StaticResource Kicker}"/><TextBlock x:Name="UpcomingText" Text="0" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="DAILY QUESTS" Style="{StaticResource Kicker}"/><TextBlock x:Name="DailyProgressText" Text="0 / 0" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="RIFT DESCENT" Style="{StaticResource Kicker}"/><TextBlock x:Name="WaveSummaryText" Text="Wave 1" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>
        <TabControl x:Name="MainTabs" Grid.Row="2" Background="#111712" BorderBrush="#38443A" Foreground="#EDF3E8">
            <TabItem Header="Tracker">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"><TextBlock Text="YOUR LIBRARY" Style="{StaticResource Kicker}"/><TextBlock Text="Games" Style="{StaticResource SectionTitle}"/></StackPanel>
                            <StackPanel DockPanel.Dock="Bottom"><TextBox x:Name="GameNameInput" ToolTip="Game name"/><Button Content="Add game" Click="AddGame_Click"/><Button Content="Remove selected game" Click="RemoveGame_Click"/></StackPanel>
                            <ListBox x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged" DisplayMemberPath="Name"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="4,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"><TextBlock Text="YOUR CALENDAR" Style="{StaticResource Kicker}"/><TextBlock Text="Event radar" Style="{StaticResource SectionTitle}"/></StackPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBox x:Name="EventTitleInput" ToolTip="Event name"/>
                                <ComboBox x:Name="EventGameInput" DisplayMemberPath="Name"/>
                                <StackPanel Orientation="Horizontal"><DatePicker x:Name="EventStartInput"/><DatePicker x:Name="EventEndInput"/></StackPanel>
                                <Button Content="Add event" Click="AddEvent_Click"/>
                                <Button Content="Complete selected event  (+100 Pulse)" Click="CompleteEvent_Click"/><Button Content="Remove selected event" Click="RemoveEvent_Click"/>
                            </StackPanel>
                            <ListBox x:Name="EventsList" DisplayMemberPath="Summary"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="8,0,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"><TextBlock Text="DAILY QUESTS" Style="{StaticResource Kicker}"/><ComboBox x:Name="QuestGameInput" DisplayMemberPath="Name" SelectionChanged="QuestGameInput_SelectionChanged"/><ListBox x:Name="DailyQuestsList" DisplayMemberPath="Summary" Height="150"/><Button Content="Complete selected daily" Click="CompleteDaily_Click"/><Button Content="Remove selected daily" Click="RemoveDailyQuest_Click"/><TextBox x:Name="DailyQuestNameInput" ToolTip="New daily quest"/><Button Content="Add daily quest" Click="AddDailyQuest_Click"/><Separator Margin="0,12"/><TextBlock Text="WEEKLY GOALS" Style="{StaticResource Kicker}"/></StackPanel>
                            <StackPanel DockPanel.Dock="Bottom"><ListBox x:Name="WeeklyGoalsList" DisplayMemberPath="Summary" Height="130"/><Button Content="Claim selected weekly reward" Click="ClaimWeekly_Click"/></StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Signal Booth">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12"><StackPanel><TextBlock Text="PULSE EXCHANGE" Style="{StaticResource Kicker}"/><TextBlock Text="Signal booth" Style="{StaticResource SectionTitle}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Pull 1  ·  100 P" Click="PullOne_Click"/><Button Content="Pull 10  ·  900 P" Click="PullTen_Click"/></StackPanel></DockPanel>
                    <TextBlock x:Name="GachaResultText" Grid.Row="1" Foreground="#D9FF72" Margin="0,0,0,10"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="CharactersList" Grid.Column="0" SelectionChanged="CharactersList_SelectionChanged">
                            <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3"><TextBlock DockPanel.Dock="Right" Text="{Binding AccountLabel}" Foreground="#D9FF72" VerticalAlignment="Center"/><Grid Width="46" Height="56" Margin="0,0,10,0"><Image Source="{Binding Portrait}" Stretch="UniformToFill"/><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EDF3E8"/></Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#A2AE9E" FontSize="11"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Collection" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CollectionSummaryText" Foreground="#A2AE9E" TextWrapping="Wrap"/><Button Content="Import a local portrait" Click="ImportPortrait_Click"/><TextBlock Text="Images stay on this device. Use artwork you have permission to use." Foreground="#A2AE9E" TextWrapping="Wrap" Margin="4,8"/></StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Rift Battler">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="ArenaCard" Grid.Row="0" CornerRadius="7" BorderBrush="#455546" BorderThickness="1" Background="#20372F" Padding="16">
                        <Grid><Canvas x:Name="ArenaCanvas" ClipToBounds="True"/><StackPanel VerticalAlignment="Top"><TextBlock x:Name="BiomeText" Text="Mosslight Ruins" Foreground="#D9FF72" FontFamily="Consolas"/><TextBlock x:Name="MonsterNameText" Text="Rift scout" FontSize="22" FontWeight="SemiBold" Margin="0,7"/><TextBlock x:Name="EnemyStatsText" Foreground="#D3DDCF"/></StackPanel><TextBlock x:Name="MonsterGlyphText" Text="◆" FontSize="76" Foreground="#D9FF72" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0"/></Grid>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,10"><StackPanel><TextBlock x:Name="WaveText" Text="Wave 1" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="BattleStatusText" Text="Next wave in 12s" Foreground="#A2AE9E"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PauseBattleButton" Content="Pause" Click="PauseBattle_Click"/><Button x:Name="ReturnBossButton" Content="Return to boss" Click="ReturnBoss_Click" Visibility="Collapsed"/></StackPanel></DockPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12"><ProgressBar x:Name="BossHealthBar" Height="9" Visibility="Collapsed"/><TextBlock x:Name="BossTimeText" Foreground="#FFB199" Visibility="Collapsed"/></StackPanel>
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,6,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="YOUR PARTY · ALL PULLED CHARACTERS CONTRIBUTE" Style="{StaticResource Kicker}" Margin="0,0,0,8"/><TextBlock x:Name="PartyStatsText" DockPanel.Dock="Bottom" Foreground="#D9FF72" Margin="0,8"/><ListBox x:Name="PartyList" DisplayMemberPath="Summary"/></DockPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="6,0,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ARMORY · AUTO-EQUIPPED WHEN BETTER" Style="{StaticResource Kicker}" Margin="0,0,0,8"/><ListBox x:Name="ArmorList" DisplayMemberPath="Summary"/></DockPanel></Border></Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
